DATABASE_URL=postgres://dnd:dnd@localhost:5432/dnd_lm

# AES-256-GCM master key for provider API keys (M7.2). 64 hex chars, never stored.
# The API refuses to boot without it. Generate: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_KEY=

# SSRF policy for per-connection base URLs (M7.3)
# Allow plain-http (not just https) localhost/127.0.0.1 for local inference:
#ALLOW_LOCAL_PROVIDERS=1
# When set, only these comma-separated hostnames pass validation:
#PROVIDER_HOST_ALLOWLIST=

# DM provider (M6, env-configured; M7 moves this to per-connection rows)
DM_PROVIDER_KIND=anthropic # or: openai_compatible
DM_PROVIDER_API_KEY=
#DM_PROVIDER_BASE_URL=http://localhost:11434/v1 # required for openai_compatible
DM_PROVIDER_MODEL=claude-opus-5
DM_PROVIDER_MAX_TOKENS=4096
# Total per-turn prompt budget in tokens (context assembly, M6.4)
DM_PROMPT_BUDGET=12000
